<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Music keeps playing when the app is in the background; the media notification is its UI. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="com.musichoarder.nativeaudio.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Home screen widgets. Providers are exported for the launcher, which sends them only
             the system's update broadcasts; they draw from files the app wrote. -->
        <receiver
            android:name="com.musichoarder.nativeaudio.NowPlayingWidgetProvider"
            android:exported="true"
            android:label="@string/mh_widget_now_playing">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mh_widget_now_playing_info" />
        </receiver>

        <receiver
            android:name="com.musichoarder.nativeaudio.LastPlayedWidgetProvider"
            android:exported="true"
            android:label="@string/mh_widget_last_played">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mh_widget_last_played_info" />
        </receiver>

        <!-- A press on a widget button while the player is up: only this app's own PendingIntents. -->
        <receiver
            android:name="com.musichoarder.nativeaudio.WidgetCommandReceiver"
            android:exported="false" />
    </application>
</manifest>
