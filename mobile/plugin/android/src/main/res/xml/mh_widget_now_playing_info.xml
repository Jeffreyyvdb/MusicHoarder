<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis 0: the app pushes every change, nothing polls. previewLayout and targetCell*
     are read from API 31; older launchers use the min sizes. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/mh_widget_now_playing_description"
    android:initialLayout="@layout/mh_widget_now_playing_small"
    android:maxResizeHeight="180dp"
    android:maxResizeWidth="400dp"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="110dp"
    android:previewLayout="@layout/mh_widget_now_playing_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
