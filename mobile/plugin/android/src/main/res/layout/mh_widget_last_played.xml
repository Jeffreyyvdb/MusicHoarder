<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mh_lp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mh_widget_background"
    android:clipToOutline="true"
    android:padding="8dp">

    <TextView
        android:id="@+id/mh_lp_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/mh_widget_shelf_empty"
        android:textColor="@color/mh_widget_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/mh_lp_cells"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/mh_lp_cell0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/mh_lp_cover0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/mh_widget_cover"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/mh_lp_title0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingTop="4dp"
                android:textColor="@color/mh_widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mh_lp_cell1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/mh_lp_cover1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/mh_widget_cover"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/mh_lp_title1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingTop="4dp"
                android:textColor="@color/mh_widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mh_lp_cell2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/mh_lp_cover2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/mh_widget_cover"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/mh_lp_title2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingTop="4dp"
                android:textColor="@color/mh_widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mh_lp_cell3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/mh_lp_cover3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/mh_widget_cover"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/mh_lp_title3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:paddingTop="4dp"
                android:textColor="@color/mh_widget_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
