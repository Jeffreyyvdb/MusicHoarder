<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mh_np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mh_widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/mh_np_cover"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="@string/mh_widget_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/mh_widget_cover_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mh_np_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/mh_widget_nothing_playing"
            android:textColor="@color/mh_widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mh_np_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/mh_widget_open_app"
            android:textColor="@color/mh_widget_text_secondary"
            android:textSize="13sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/mh_np_previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:contentDescription="@string/mh_widget_previous"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mh_widget_ic_previous" />

            <ImageButton
                android:id="@+id/mh_np_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/mh_widget_button"
                android:contentDescription="@string/mh_widget_play"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mh_widget_ic_play" />

            <ImageButton
                android:id="@+id/mh_np_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:contentDescription="@string/mh_widget_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mh_widget_ic_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
