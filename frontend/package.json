{
  "name": "musichoarder-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start:prod": "bun build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxfmt --check && svelte-kit sync && oxlint && bun oxlint/svelte-markup.mjs",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "format": "oxfmt",
    "prepare": "git config core.hooksPath .githooks || true",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci"
  },
  "dependencies": {
    "@lucide/svelte": "^1.72.0",
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@ui-sdk/core": "0.1.0-beta.2",
    "@ui-sdk/svelte": "0.1.0-beta.2",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "import-in-the-middle": "^3.6.0",
    "mode-watcher": "^1.1.0",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "postcss": "^8.5.32",
    "semantic-release": "^25.0.9",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
